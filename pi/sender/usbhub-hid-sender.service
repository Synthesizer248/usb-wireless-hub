[Unit]
Description=USBHub HID Keyboard TLS Sender
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/admin/hid-bridge/sender
EnvironmentFile=/etc/usbhub-hid-sender.env
ExecStart=/usr/bin/python3 ${USBHUB_SENDER_SCRIPT} ${USBHUB_RECEIVER_IP} ${USBHUB_RECEIVER_PORT} ${USBHUB_SERVER_CERT_SHA256} ${USBHUB_CLIENT_CERT} ${USBHUB_CLIENT_KEY}
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
