# Copy to /etc/usbhub-hid-sender.env and replace every value.
USBHUB_SENDER_SCRIPT=/home/admin/hid-bridge/sender/sender.py
USBHUB_RECEIVER_IP=REPLACE_WITH_WINDOWS_PC_IP
USBHUB_RECEIVER_PORT=5000
USBHUB_SERVER_CERT_SHA256=REPLACE_WITH_RECEIVER_CERT_SHA256
USBHUB_CLIENT_CERT=/home/admin/hid-bridge/certs/pi-client.crt
USBHUB_CLIENT_KEY=/home/admin/hid-bridge/certs/pi-client.key
