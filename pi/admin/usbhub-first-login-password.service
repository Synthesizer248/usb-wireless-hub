[Unit]
Description=Require a password change on first USBHub administrator login
After=cloud-config.service
Wants=cloud-config.service
Before=cockpit.socket
ConditionPathExists=!/var/lib/usbhub/first-login-password-armed

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/usbhub-first-login-password
RemainAfterExit=yes
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
